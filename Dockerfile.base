# ---------------------------------------------------------
# Ranvier Base Builder Image
# ---------------------------------------------------------
# This image contains OS, build tools, Rust, Seastar, and pre-built
# dependencies to speed up production builds.
#
# Build:
#   docker build -f Dockerfile.base -t my-registry/ranvier-base:latest .
#   docker push my-registry/ranvier-base:latest
#
# Rebuild this base image only when:
#   - Upgrading Fedora version
#   - Upgrading Seastar version (bump SEASTAR_REF below)
#   - Upgrading tokenizers-cpp version
#   - Adding new system-level build dependencies
# ---------------------------------------------------------
FROM fedora:39

LABEL org.opencontainers.image.title="Ranvier Base Builder"
LABEL org.opencontainers.image.description="Pre-built Seastar + Rust + deps for Ranvier builds"

# Layer 1: System packages (rarely changes)
# Install abseil, protobuf, yaml-cpp from system to avoid rebuilding
RUN dnf install -y \
        git \
        cmake \
        gcc-c++ \
        ninja-build \
        python3 \
        python3-pip \
        curl \
        libcurl-devel \
        openssl \
        openssl-devel \
        protobuf-devel \
        abseil-cpp-devel \
        yaml-cpp-devel \
        gtest-devel \
        gmock-devel \
        sqlite-devel \
        zeromq-devel \
        grpc-devel \
        grpc-plugins \
        protobuf-compiler \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# Layer 2: Rust toolchain
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# Layer 3: Seastar - consolidated build + cleanup in single layer
WORKDIR /tmp
# Pinned Seastar commit: scylladb/seastar master as of 2026-07-16, the last
# state the unpinned clone built here (base image run of 2026-07-18). Two
# upstream constraints bound this pin (BACKLOG §5.1):
#   - Seastar retired C++20 (build config 2026-06-17; first C++23-only code in
#     src/core/prometheus.cc on 2026-08-25, std::views::zip; master also uses
#     std::ranges::to, which needs GCC 14). Moving past this commit needs
#     --c++-standard=23, a newer Fedora/GCC base, and Ranvier on C++23.
#   - Since 2026-07-07 Seastar links LTTng-UST by default but its installed
#     CMake config never tells consumers, so a static Seastar built with it
#     fails every downstream configure with "LTTng::UST ... target was not
#     found". Hence --disable-lttng below; Ranvier does not use IO tracing.
# Bump deliberately, as one tracked change, and rebuild.
ARG SEASTAR_REF=837ecedbbd8d7d2fbd71be730b7a2248d272a914
RUN mkdir seastar && cd seastar && \
    git init -q && \
    git remote add origin https://github.com/scylladb/seastar.git && \
    git fetch -q --depth 1 origin "${SEASTAR_REF}" && \
    git checkout -q FETCH_HEAD && \
    ./install-dependencies.sh && \
    dnf clean all && \
    ./configure.py --mode=release --prefix=/usr/local --c++-standard=20 --without-tests --without-apps --without-demos --disable-lttng && \
    ninja -j$(nproc) -C build/release install && \
    cd /tmp && \
    rm -rf seastar && \
    rm -rf /var/cache/dnf /root/.cache /tmp/*

# Layer 4: Pre-clone and pre-build tokenizers-cpp (the slowest dependency)
# This builds the Rust tokenizers crate which takes ~5-8 minutes
# Set CARGO_TARGET_DIR so production builds can reuse the Rust artifacts
#
# IMPORTANT: We patch tokenizers-cpp to use jemalloc as Rust's global allocator.
# WHY: Seastar replaces malloc globally with its per-shard allocator. When Rust
# FFI code runs on worker threads, allocations are tracked as foreign_mallocs.
# The interaction between Seastar's do_foreign_free and Rust's internal allocator
# causes memory corruption under stress (SIGSEGV with corrupted pointers).
# See: Rule #15 in .dev-context/claude-context.md
WORKDIR /deps
ENV CARGO_TARGET_DIR=/deps/tokenizers-cpp/rust/target
# Pinned commit: 2026-01-23 (CMake compat + HF tokenizer 0.21.2)
# To update: see "Updating pinned tokenizers-cpp" in BACKLOG.md §20.10.
RUN git clone https://github.com/mlc-ai/tokenizers-cpp.git && \
    cd tokenizers-cpp && \
    git checkout 34885cfd7b9ef27b859c28a41e71413dd31926f5 && \
    git submodule update --init --recursive && \
    # Patch Cargo.toml: Add tikv-jemallocator dependency
    sed -i 's/\[dependencies\]/[dependencies]\ntikv-jemallocator = "0.6"/' rust/Cargo.toml && \
    # Patch lib.rs: Add global allocator declaration at the top
    sed -i '1i\// PATCHED BY RANVIER: Use jemalloc for Seastar compatibility (Rule #15)\nuse tikv_jemallocator::Jemalloc;\n\n#[global_allocator]\nstatic GLOBAL: Jemalloc = Jemalloc;\n' rust/src/lib.rs && \
    # Build with patches applied
    mkdir build && cd build && \
    cmake .. -G Ninja -DCMAKE_BUILD_TYPE=Release && \
    ninja && \
    rm -rf /root/.cargo/registry/cache

# Layer 5: Pre-clone opentelemetry-cpp (moderate build time)
RUN git clone --depth 1 --branch v1.14.2 https://github.com/open-telemetry/opentelemetry-cpp.git /deps/opentelemetry-cpp

# Layer 6: Pre-clone rapidjson (header-only, instant)
RUN git clone --depth 1 --branch v1.1.0 https://github.com/Tencent/rapidjson.git /deps/rapidjson

WORKDIR /src
