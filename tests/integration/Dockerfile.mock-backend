# Lightweight mock backend for integration testing
FROM python:3.11-slim

WORKDIR /app
COPY mock_backend.py .

# pyzmq backs the optional KV-event publisher (MOCK_KV_EVENTS_PORT); the mock
# runs without it and reports the publisher unavailable.
RUN pip install --no-cache-dir pyzmq==26.2.0

# Make executable
RUN chmod +x mock_backend.py

# Disable Python output buffering for Docker logs
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["python3", "-u", "mock_backend.py"]
